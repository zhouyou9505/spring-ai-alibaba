{
  "type": "object",
  "properties": {
    "workflowId": {
      "type": "string",
      "description": "工作流的唯一标识符"
    },
    "name": {
      "type": "string",
      "description": "工作流名称"
    },
    "description": {
      "type": "string",
      "description": "工作流描述"
    },
    "version": {
      "type": "string",
      "description": "工作流版本号"
    },
    "agents": {
      "type": "array",
      "description": "Agent配置列表",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "description": "Agent的唯一标识符"
          },
          "name": {
            "type": "string",
            "description": "Agent名称"
          },
          "type": {
            "type": "string",
            "enum": ["llm", "react", "react_with_human", "reflect"],
            "description": "Agent类型：llm（简单LLM对话）、react（ReAct模式，支持工具调用）、react_with_human（支持人工干预）、reflect（具备反思优化能力）"
          },
          "description": {
            "type": "string",
            "description": "Agent描述"
          },
          "instructions": {
            "type": "string",
            "description": "Agent的具体指令"
          },
          "model": {
            "type": "string",
            "description": "使用的AI模型"
          },
          "config": {
            "type": "object",
            "description": "Agent的具体配置",
            "additionalProperties": true
          },
          "inputKey": {
            "type": "string",
            "description": "输入键名"
          },
          "outputKey": {
            "type": "string",
            "description": "输出键名"
          },
          "options": {
            "type": "object",
            "description": "Agent选项配置",
            "properties": {
              "toggleAble": {
                "type": "boolean",
                "default": true,
                "description": "是否可启用/禁用"
              },
              "ragReturnType": {
                "type": "string",
                "enum": ["chunks", "content"],
                "default": "chunks",
                "description": "RAG返回类型"
              },
              "ragK": {
                "type": "number",
                "default": 3,
                "description": "RAG检索数量"
              },
              "controlType": {
                "type": "string",
                "enum": ["retain", "relinquish_to_parent", "relinquish_to_start", "auto", "manual"],
                "default": "auto",
                "description": "控制类型"
              },
              "outputVisibility": {
                "type": "string",
                "enum": ["user_facing", "internal", "public"],
                "default": "public",
                "description": "输出可见性"
              },
              "examples": {
                "type": "string",
                "description": "示例数据"
              },
              "order": {
                "type": "integer",
                "description": "执行顺序"
              },
              "disabled": {
                "type": "boolean",
                "default": false,
                "description": "是否禁用"
              },
              "locked": {
                "type": "boolean",
                "default": false,
                "description": "是否锁定"
              },
              "maxCallsPerParentAgent": {
                "type": "number",
                "default": 3,
                "description": "每个父Agent的最大调用次数"
              },
              "maxRetries": {
                "type": "number",
                "default": 3,
                "description": "最大重试次数"
              },
              "timeout": {
                "type": "number",
                "default": 30000,
                "description": "超时时间（毫秒）"
              },
              "global": {
                "type": "boolean",
                "default": false,
                "description": "是否为全局Agent"
              },
              "ragDataSources": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "RAG数据源"
              }
            },
            "additionalProperties": false
          },
          "tools": {
            "type": "array",
            "description": "Agent可用的工具列表。如果为空且Agent类型为react、react_with_human、reflect，将自动添加mock_tool",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "工具名称。如果为mock_tool，将自动生成模拟参数和描述"
                },
                "description": {
                  "type": "string",
                  "description": "工具描述（可选，mock_tool会自动生成）"
                },
                "parameters": {
                  "type": "object",
                  "description": "工具参数定义（可选，mock_tool会自动生成）",
                  "additionalProperties": true
                },
                "autoMock": {
                  "type": "boolean",
                  "default": false,
                  "description": "是否自动生成mock工具（当工具不存在时）"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          }
        },
        "required": ["agentId", "name", "type", "description", "instructions"],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "description": "边配置列表",
      "items": {
        "type": "object",
        "properties": {
          "edgeId": {
            "type": "string",
            "description": "边的唯一标识符"
          },
          "fromAgentId": {
            "type": "string",
            "description": "起始Agent ID"
          },
          "toAgentId": {
            "type": "string",
            "description": "目标Agent ID"
          },
          "label": {
            "type": "string",
            "description": "边的标签"
          },
          "condition": {
            "type": "string",
            "description": "条件表达式"
          },
          "edgeType": {
            "type": "string",
            "enum": ["SEQUENTIAL", "CONDITIONAL", "LOOP", "PARALLEL"],
            "default": "SEQUENTIAL",
            "description": "边类型"
          },
          "config": {
            "type": "object",
            "description": "边配置",
            "additionalProperties": true
          }
        },
        "required": ["edgeId", "fromAgentId", "toAgentId"],
        "additionalProperties": false
      }
    },
    "prompts": {
      "type": "array",
      "description": "提示词配置列表",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "提示词名称"
          },
          "type": {
            "type": "string",
            "enum": ["base_prompt", "style_prompt", "greeting", "system_prompt", "user_prompt"],
            "description": "提示词类型"
          },
          "prompt": {
            "type": "string",
            "description": "提示词内容"
          },
          "description": {
            "type": "string",
            "description": "提示词描述"
          }
        },
        "required": ["name", "type", "prompt"],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "description": "工具配置列表",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "工具名称"
          },
          "description": {
            "type": "string",
            "description": "工具描述"
          },
          "mockTool": {
            "type": "boolean",
            "default": false,
            "description": "是否为模拟工具"
          },
          "autoSubmitMockedResponse": {
            "type": "boolean",
            "default": false,
            "description": "是否自动提交模拟响应"
          },
          "mockInstructions": {
            "type": "string",
            "description": "模拟指令"
          },
          "parameters": {
            "type": "object",
            "description": "工具参数定义",
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "enum": {
                      "type": "array"
                    },
                    "default": {},
                    "minimum": {
                      "type": "number"
                    },
                    "maximum": {
                      "type": "number"
                    },
                    "items": {},
                    "format": {
                      "type": "string"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "minLength": {
                      "type": "number"
                    },
                    "maxLength": {
                      "type": "number"
                    },
                    "minItems": {
                      "type": "number"
                    },
                    "maxItems": {
                      "type": "number"
                    },
                    "uniqueItems": {
                      "type": "boolean"
                    },
                    "multipleOf": {
                      "type": "number"
                    },
                    "examples": {
                      "type": "array"
                    }
                  },
                  "required": ["type", "description"],
                  "additionalProperties": false
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": ["type", "properties"],
            "additionalProperties": false,
            "default": {
              "type": "object",
              "properties": {},
              "required": []
            }
          },
          "isMcp": {
            "type": "boolean",
            "default": false,
            "description": "是否为MCP工具"
          },
          "isLibrary": {
            "type": "boolean",
            "default": false,
            "description": "是否为库工具"
          },
          "mcpServerName": {
            "type": "string",
            "description": "MCP服务器名称"
          },
          "mcpServerURL": {
            "type": "string",
            "description": "MCP服务器URL"
          }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "startAgent": {
      "type": "string",
      "description": "起始Agent ID"
    },
    "globalConfig": {
      "type": "object",
      "description": "全局配置",
      "properties": {
        "maxRetries": {
          "type": "number",
          "default": 3,
          "description": "最大重试次数"
        },
        "timeout": {
          "type": "number",
          "default": 30000,
          "description": "超时时间（毫秒）"
        },
        "enableLogging": {
          "type": "boolean",
          "default": true,
          "description": "是否启用日志"
        },
        "enableMetrics": {
          "type": "boolean",
          "default": true,
          "description": "是否启用指标"
        },
        "maxLoopIterations": {
          "type": "number",
          "default": 5,
          "description": "最大循环迭代次数"
        },
        "parallelExecution": {
          "type": "boolean",
          "default": false,
          "description": "是否并行执行"
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "工作流元数据",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        },
        "lastUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "最后更新时间"
        },
        "author": {
          "type": "string",
          "description": "作者"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "标签列表"
        },
        "category": {
          "type": "string",
          "description": "分类"
        },
        "customFields": {
          "type": "object",
          "description": "自定义字段",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["workflowId", "name", "agents", "edges"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "agentTypes": {
      "description": "Agent类型详细说明",
      "llm": {
        "description": "简单LLM对话Agent",
        "特点": ["直接与LLM对话", "无工具调用", "适合简单问答"],
        "适用场景": ["客服对话", "内容生成", "简单咨询"],
        "配置建议": {
          "tools": "通常为空或简单工具",
          "maxIterations": "1",
          "instructions": "直接的用户指令"
        }
      },
      "react": {
        "description": "ReAct模式Agent，支持工具调用",
        "特点": ["推理+行动循环", "支持工具调用", "记忆持久化", "流式输出"],
        "适用场景": ["自动问答", "工具调用", "任务执行", "数据分析"],
        "配置建议": {
          "tools": "配置相关工具列表",
          "maxIterations": "5-10",
          "instructions": "包含推理和行动步骤的指令"
        }
      },
      "react_with_human": {
        "description": "支持人工干预的ReAct Agent",
        "特点": ["ReAct基础上增加人工节点", "支持中断和恢复", "审批机制"],
        "适用场景": ["医疗诊断建议", "金融审批", "法律文档生成", "合规审核"],
        "配置建议": {
          "tools": "配置相关工具",
          "maxIterations": "8-15",
          "instructions": "包含人工确认点的指令"
        }
      },
      "reflect": {
        "description": "具备反思优化能力的Agent",
        "特点": ["生成→评估→改进闭环", "双节点设计", "多轮迭代", "自动记录反思"],
        "适用场景": ["高质量内容生成", "代码生成", "错误修正", "知识问答优化"],
        "配置建议": {
          "tools": "配置生成和评估工具",
          "maxIterations": "3-5",
          "instructions": "包含反思和改进步骤的指令"
        }
      }
    }
  }
}