{
  "type": "object",
  "properties": {
    "workflowId": {
      "type": "string",
      "description": "工作流的唯一标识符"
    },
    "name": {
      "type": "string",
      "description": "工作流名称"
    },
    "description": {
      "type": "string",
      "description": "工作流描述"
    },
    "version": {
      "type": "string",
      "description": "工作流版本号"
    },
    "agents": {
      "type": "array",
      "description": "Agent配置列表",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "description": "Agent的唯一标识符"
          },
          "name": {
            "type": "string",
            "description": "Agent名称"
          },
          "type": {
            "type": "string",
            "enum": ["llm", "react", "react_with_human"],
            "description": "Agent类型：llm（简单LLM对话）、react（ReAct模式，支持工具调用）、react_with_human（支持人工干预）"
          },
          "description": {
            "type": "string",
            "description": "Agent描述"
          },
          "instructions": {
            "type": "string",
            "description": "Agent的具体指令。对于有输出约束的Agent，必须在instructions中明确指定输出格式和有效值。例如：分类Agent应指定'You MUST respond with ONLY: value1, value2, value3'；结构化输出Agent应指定'Return results in this exact format: {...}'"
          },
          "model": {
            "type": "string",
            "description": "使用的AI模型"
          },
          "config": {
            "type": "object",
            "description": "Agent的具体配置",
            "additionalProperties": true
          },
          "inputKey": {
            "type": "string",
            "description": "输入键名"
          },
          "outputKey": {
            "type": "string",
            "description": "输出键名"
          },
          "options": {
            "type": "object",
            "description": "Agent选项配置",
            "properties": {
              "toggleAble": {
                "type": "boolean",
                "default": true,
                "description": "是否可启用/禁用"
              },
              "ragReturnType": {
                "type": "string",
                "enum": ["chunks", "content"],
                "default": "chunks",
                "description": "RAG返回类型"
              },
              "ragK": {
                "type": "number",
                "default": 3,
                "description": "RAG检索数量"
              },
              "controlType": {
                "type": "string",
                "enum": ["retain", "relinquish_to_parent", "relinquish_to_start", "auto", "manual"],
                "default": "auto",
                "description": "控制类型"
              },
              "outputVisibility": {
                "type": "string",
                "enum": ["user_facing", "internal", "public"],
                "default": "public",
                "description": "输出可见性"
              },
              "examples": {
                "type": "string",
                "description": "示例数据"
              },
              "order": {
                "type": "integer",
                "description": "执行顺序"
              },
              "disabled": {
                "type": "boolean",
                "default": false,
                "description": "是否禁用"
              },
              "locked": {
                "type": "boolean",
                "default": false,
                "description": "是否锁定"
              },
              "maxCallsPerParentAgent": {
                "type": "number",
                "default": 3,
                "description": "每个父Agent的最大调用次数"
              },
              "maxRetries": {
                "type": "number",
                "default": 3,
                "description": "最大重试次数"
              },
              "timeout": {
                "type": "number",
                "default": 30000,
                "description": "超时时间（毫秒）"
              },
              "global": {
                "type": "boolean",
                "default": false,
                "description": "是否为全局Agent"
              },
              "ragDataSources": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "RAG数据源"
              }
            },
            "additionalProperties": false
          },
          "tools": {
            "type": "array",
            "description": "Agent可用的工具列表。如果为空且Agent类型为react、react_with_human，将自动添加mock_tool",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "工具名称。如果autoMock=true，将自动生成模拟参数和描述"
                },
                "description": {
                  "type": "string",
                  "description": "工具描述（可选，如果autoMock=true会自动生成工具描述）"
                },
                "parameters": {
                  "type": "object",
                  "description": "工具参数定义（可选，如果autoMock=true自动生成参数定义）",
                  "additionalProperties": true
                },
                "autoMock": {
                  "type": "boolean",
                  "default": false,
                  "description": "如果用户的要求工具不在预置的工具列表里，autoMock设置为true，autoMock=true，否则为false"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          }
        },
        "required": ["agentId", "name", "type", "description", "instructions"],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "description": "边配置列表",
      "items": {
        "type": "object",
        "properties": {
          "edgeId": {
            "type": "string",
            "description": "边的唯一标识符"
          },
          "fromAgentId": {
            "type": "string",
            "description": "起始Agent ID"
          },
          "toAgentId": {
            "type": "string",
            "description": "目标Agent ID"
          },
          "label": {
            "type": "string",
            "description": "边的标签"
          },
          "condition": {
            "type": "object",
            "description": "条件表达式，使用JSON对象格式。当edge有condition值时，fromAgentId对应的agent必须在instructions中明确指定输出约束，确保输出结果只能是condition中指定的值。例如：condition为{\"request_category\": \"technical\"}时，对应的agent必须输出\"technical\"",
            "additionalProperties": {
              "type": "string",
              "description": "条件值，必须与对应agent的输出值精确匹配"
            },
            "examples": [
              {"request_category": "technical"},
              {"approval_decision": "approved"},
              {"priority_level": "high"}
            ]
          },
          "edgeType": {
            "type": "string",
            "enum": ["SEQUENTIAL", "CONDITIONAL", "LOOP", "PARALLEL"],
            "default": "SEQUENTIAL",
            "description": "边类型"
          },
          "config": {
            "type": "object",
            "description": "边配置",
            "additionalProperties": true
          }
        },
        "required": ["edgeId", "fromAgentId", "toAgentId"],
        "additionalProperties": false
      }
    },
    "prompts": {
      "type": "array",
      "description": "提示词配置列表",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "提示词名称"
          },
          "type": {
            "type": "string",
            "enum": ["base_prompt", "style_prompt", "greeting", "system_prompt", "user_prompt"],
            "description": "提示词类型"
          },
          "prompt": {
            "type": "string",
            "description": "提示词内容"
          },
          "description": {
            "type": "string",
            "description": "提示词描述"
          }
        },
        "required": ["name", "type", "prompt"],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "description": "工具配置列表",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "工具名称"
          },
          "description": {
            "type": "string",
            "description": "工具描述"
          },
          "mockTool": {
            "type": "boolean",
            "default": false,
            "description": "是否为模拟工具"
          },
          "autoSubmitMockedResponse": {
            "type": "boolean",
            "default": false,
            "description": "是否自动提交模拟响应"
          },
          "mockInstructions": {
            "type": "string",
            "description": "模拟指令"
          },
          "parameters": {
            "type": "object",
            "description": "工具参数定义",
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "enum": {
                      "type": "array"
                    },
                    "default": {},
                    "minimum": {
                      "type": "number"
                    },
                    "maximum": {
                      "type": "number"
                    },
                    "items": {},
                    "format": {
                      "type": "string"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "minLength": {
                      "type": "number"
                    },
                    "maxLength": {
                      "type": "number"
                    },
                    "minItems": {
                      "type": "number"
                    },
                    "maxItems": {
                      "type": "number"
                    },
                    "uniqueItems": {
                      "type": "boolean"
                    },
                    "multipleOf": {
                      "type": "number"
                    },
                    "examples": {
                      "type": "array"
                    }
                  },
                  "required": ["type", "description"],
                  "additionalProperties": false
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": ["type", "properties"],
            "additionalProperties": false,
            "default": {
              "type": "object",
              "properties": {},
              "required": []
            }
          },
          "isMcp": {
            "type": "boolean",
            "default": false,
            "description": "是否为MCP工具"
          },
          "isLibrary": {
            "type": "boolean",
            "default": false,
            "description": "是否为库工具"
          },
          "mcpServerName": {
            "type": "string",
            "description": "MCP服务器名称"
          },
          "mcpServerURL": {
            "type": "string",
            "description": "MCP服务器URL"
          }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "startAgent": {
      "type": "string",
      "description": "起始Agent ID"
    },
    "globalConfig": {
      "type": "object",
      "description": "全局配置",
      "properties": {
        "maxRetries": {
          "type": "number",
          "default": 3,
          "description": "最大重试次数"
        },
        "timeout": {
          "type": "number",
          "default": 30000,
          "description": "超时时间（毫秒）"
        },
        "enableLogging": {
          "type": "boolean",
          "default": true,
          "description": "是否启用日志"
        },
        "enableMetrics": {
          "type": "boolean",
          "default": true,
          "description": "是否启用指标"
        },
        "maxLoopIterations": {
          "type": "number",
          "default": 5,
          "description": "最大循环迭代次数"
        },
        "parallelExecution": {
          "type": "boolean",
          "default": false,
          "description": "是否并行执行"
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "工作流元数据",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        },
        "lastUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "最后更新时间"
        },
        "author": {
          "type": "string",
          "description": "作者"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "标签列表"
        },
        "category": {
          "type": "string",
          "description": "分类"
        },
        "customFields": {
          "type": "object",
          "description": "自定义字段",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["workflowId", "name", "agents", "edges"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "agentTypes": {
      "description": "Agent类型详细说明",
      "llm": {
        "description": "简单LLM对话Agent",
        "特点": ["直接与LLM对话", "无工具调用", "适合简单问答"],
        "适用场景": ["客服对话", "内容生成", "简单咨询", "分类决策", "内容总结"],
        "配置建议": {
          "tools": "通常为空或简单工具",
          "maxIterations": "1",
          "instructions": "直接的用户指令，对于分类Agent必须指定输出约束"
        }
      },
      "react": {
        "description": "ReAct模式Agent，支持工具调用",
        "特点": ["推理+行动循环", "支持工具调用", "记忆持久化", "流式输出"],
        "适用场景": ["自动问答", "工具调用", "任务执行", "数据分析", "结构化输出"],
        "配置建议": {
          "tools": "配置相关工具列表",
          "maxIterations": "5-10",
          "instructions": "包含推理和行动步骤的指令，对于结构化输出必须指定JSON格式"
        }
      },
      "react_with_human": {
        "description": "支持人工干预的ReAct Agent",
        "特点": [
          "ReAct基础上增加人工节点",
          "支持中断和恢复",
          "审批机制"
        ],
        "适用场景": [
          "医疗诊断建议",
          "金融审批",
          "法律文档生成",
          "合规审核",
          "复杂决策"
        ],
        "配置建议": {
          "tools": "配置相关工具",
          "maxIterations": "8-15",
          "instructions": "包含人工确认点的指令，对于决策Agent必须指定输出约束"
        }
      }
    },
    "outputConstraints": {
      "description": "输出约束模式",
      "exactValueMatching": {
        "description": "精确值匹配，用于条件路由",
        "pattern": "You MUST respond with ONLY: 'value1', 'value2', 'value3'",
        "examples": ["分类Agent", "审批决策", "状态判断"],
        "useCase": "当Agent输出需要与条件边的值精确匹配时使用"
      },
      "structuredFormat": {
        "description": "结构化格式输出",
        "pattern": "Return results in this exact format: {...}",
        "examples": ["JSON响应", "结构化数据", "分析报告"],
        "useCase": "当后续Agent需要解析特定格式数据时使用"
      },
      "booleanDecisions": {
        "description": "布尔决策输出",
        "pattern": "Respond with exactly 'yes' or 'no'",
        "examples": ["简单决策点", "是/否判断", "通过/拒绝"],
        "useCase": "用于简单的二元决策路由"
      },
      "rangeValues": {
        "description": "数值范围输出",
        "pattern": "Provide a number between 1-10",
        "examples": ["评分系统", "优先级", "满意度"],
        "useCase": "用于需要数值比较的条件路由"
      }
    },
    "conditionalEdgeIntegration": {
      "description": "条件边集成指南",
      "requirements": [
        "Agent的输出值必须与条件边的值精确匹配",
        "分类Agent的输出必须与路由条件一致",
        "结构化输出必须包含条件边需要的字段",
        "决策Agent的输出必须与后续路由逻辑匹配"
      ],
      "criticalRule": {
        "description": "关键规则：当edge有condition时，fromAgentId agent必须有输出约束",
        "rule": "If edge.condition exists, then fromAgentId.instructions MUST contain output constraints matching condition values",
        "example": {
          "edge": {
            "fromAgentId": "classification_agent",
            "condition": {"request_category": "technical"}
          },
          "requiredInstructions": "You MUST respond with ONLY: 'technical', 'billing', 'general'. Valid responses are: 'technical', 'billing', 'general'."
        }
      },
      "validationSteps": [
        "检查每个有condition的edge",
        "验证fromAgentId agent的instructions是否包含输出约束",
        "确认输出值是否与condition值精确匹配",
        "确保所有可能的condition值都在instructions中列出"
      ],
      "examples": {
        "classificationRouting": {
          "agentOutput": "technical",
          "condition": {"request_category": "technical"},
          "description": "分类Agent输出'technical'，条件边检查'request_category'为'technical'",
          "requiredInstructions": "You MUST respond with ONLY: 'technical', 'billing', 'general'"
        },
        "approvalRouting": {
          "agentOutput": "approved",
          "condition": {"approval_decision": "approved"},
          "description": "审批Agent输出'approved'，条件边检查'approval_decision'为'approved'",
          "requiredInstructions": "Respond with exactly 'approved' or 'rejected'"
        },
        "priorityRouting": {
          "agentOutput": "high",
          "condition": {"priority_level": "high"},
          "description": "优先级Agent输出'high'，条件边检查'priority_level'为'high'",
          "requiredInstructions": "Classify priority as 'low', 'medium', or 'high' only"
        }
      }
    },
    "outputConstraintValidation": {
      "description": "输出约束验证规则",
      "rules": [
        {
          "name": "ConditionalEdgeConstraint",
          "description": "条件边约束规则",
          "condition": "edge.condition != null",
          "requirement": "fromAgentId.instructions must contain output constraints",
          "validation": "Check if instructions specify exact output values matching condition"
        },
        {
          "name": "ValueMatching",
          "description": "值匹配规则",
          "condition": "edge.condition has specific values",
          "requirement": "Agent output must match condition values exactly",
          "validation": "Verify all condition values are listed in agent instructions"
        },
        {
          "name": "FormatConsistency",
          "description": "格式一致性规则",
          "condition": "edge.condition expects structured data",
          "requirement": "Agent must specify exact output format",
          "validation": "Check if instructions specify JSON structure or format"
        }
      ],
      "commonPatterns": {
        "exactValue": {
          "pattern": "You MUST respond with ONLY: 'value1', 'value2', 'value3'",
          "useCase": "Classification agents with conditional routing"
        },
        "booleanDecision": {
          "pattern": "Respond with exactly 'yes' or 'no'",
          "useCase": "Simple decision points"
        },
        "structuredOutput": {
          "pattern": "Return results in this exact format: {...}",
          "useCase": "Data processing with structured output"
        },
        "rangeValue": {
          "pattern": "Provide a number between 1-10",
          "useCase": "Scoring or rating systems"
        }
      }
    }
  }
}