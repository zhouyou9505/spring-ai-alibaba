{
  "workflowId": "sample-workflow-001",
  "name": "文本处理工作流",
  "description": "这是一个示例工作流，演示了从输入处理到LLM调用再到输出处理的完整流程",
  "nodes": [
    {
      "nodeId": "input_node",
      "nodeType": "simple",
      "name": "输入处理节点",
      "config": {
        "inputKey": "input",
        "outputKey": "processed_input"
      },
      "inputMapping": {
        "input": "input"
      },
      "outputMapping": {
        "output": "processed_input"
      }
    },
    {
      "nodeId": "llm_node",
      "nodeType": "llm",
      "name": "LLM处理节点",
      "config": {
        "systemPrompt": "你是一个有用的AI助手，请帮助用户处理文本内容。",
        "userPrompt": "请分析以下文本内容并提供改进建议：{input}",
        "outputKey": "llm_response"
      },
      "inputMapping": {
        "input": "processed_input"
      },
      "outputMapping": {
        "response": "llm_response"
      }
    },
    {
      "nodeId": "condition_node",
      "nodeType": "condition",
      "name": "条件判断节点",
      "config": {
        "condition": "llm_response.length > 100",
        "trueNext": "output_node",
        "falseNext": "short_response_node"
      },
      "inputMapping": {
        "llm_response": "llm_response"
      },
      "outputMapping": {
        "condition_result": "is_long_response",
        "next_node": "next_step"
      }
    },
    {
      "nodeId": "output_node",
      "nodeType": "custom",
      "name": "输出处理节点",
      "config": {
        "customLogic": "uppercase"
      },
      "inputMapping": {
        "input": "llm_response"
      },
      "outputMapping": {
        "output": "final_output"
      }
    },
    {
      "nodeId": "short_response_node",
      "nodeType": "custom",
      "name": "短响应处理节点",
      "config": {
        "customLogic": "lowercase"
      },
      "inputMapping": {
        "input": "llm_response"
      },
      "outputMapping": {
        "output": "final_output"
      }
    }
  ],
  "edges": [
    {
      "edgeId": "edge1",
      "fromNodeId": "START",
      "toNodeId": "input_node",
      "condition": null,
      "config": {}
    },
    {
      "edgeId": "edge2",
      "fromNodeId": "input_node",
      "toNodeId": "llm_node",
      "condition": null,
      "config": {}
    },
    {
      "edgeId": "edge3",
      "fromNodeId": "llm_node",
      "toNodeId": "condition_node",
      "condition": null,
      "config": {}
    },
    {
      "edgeId": "edge4",
      "fromNodeId": "condition_node",
      "toNodeId": "output_node",
      "condition": "is_long_response == true",
      "config": {}
    },
    {
      "edgeId": "edge5",
      "fromNodeId": "condition_node",
      "toNodeId": "short_response_node",
      "condition": "is_long_response == false",
      "config": {}
    },
    {
      "edgeId": "edge6",
      "fromNodeId": "output_node",
      "toNodeId": "END",
      "condition": null,
      "config": {}
    },
    {
      "edgeId": "edge7",
      "fromNodeId": "short_response_node",
      "toNodeId": "END",
      "condition": null,
      "config": {}
    }
  ],
  "globalConfig": {
    "maxRetries": 3,
    "timeout": 30000,
    "enableLogging": true,
    "enableMetrics": true
  }
} 