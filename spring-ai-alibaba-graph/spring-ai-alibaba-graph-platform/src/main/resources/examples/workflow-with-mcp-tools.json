{
  "workflowId": "tools-workflow-demo",
  "name": "工具工作流演示",
  "description": "展示如何在 Agent 中配置工具",
  "version": "1.0.0",
  "agents": [
    {
      "agentId": "simple_llm_agent",
      "name": "简单LLM Agent",
      "type": "llm",
      "description": "使用工具进行简单处理",
      "instructions": "你是一个简单的LLM助手，使用工具进行文本处理。",
      "model": "qwen-turbo",
      "config": {
        "inputKey": "user_input",
        "outputKey": "llm_response"
      },
      "inputMapping": {
        "user_input": "user_topic"
      },
      "outputMapping": {
        "llm_response": "llm_output"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "text_processor"
        },
        {
          "name": "language_detector"
        }
      ]
    },
    {
      "agentId": "research_agent",
      "name": "研究Agent",
      "type": "react",
      "description": "使用工具进行研究",
      "instructions": "你是一个研究助手，使用工具进行研究。",
      "model": "qwen-turbo",
      "config": {
        "prompt": "请研究以下主题：{topic}。使用可用的工具来获取信息。",
        "maxIterations": 8,
        "inputKey": "topic",
        "outputKey": "research_result"
      },
      "inputMapping": {
        "topic": "llm_output"
      },
      "outputMapping": {
        "research_result": "research_output"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "web_search"
        },
        {
          "name": "database_query"
        }
      ]
    },
    {
      "agentId": "analysis_agent",
      "name": "分析Agent",
      "type": "react_with_human",
      "description": "使用工具进行分析",
      "instructions": "你是一个分析助手，使用工具进行数据分析。",
      "model": "qwen-turbo",
      "config": {
        "prompt": "请分析以下数据：{data}。使用可用的工具进行分析。",
        "maxIterations": 10,
        "inputKey": "data",
        "outputKey": "analysis_result"
      },
      "inputMapping": {
        "data": "research_output"
      },
      "outputMapping": {
        "analysis_result": "final_result"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "data_analysis"
        },
        {
          "name": "chart_generator"
        }
      ]
    },
    {
      "agentId": "content_agent",
      "name": "内容Agent",
      "type": "reflect",
      "description": "使用工具生成内容",
      "instructions": "你是一个内容专家，使用工具生成高质量内容。",
      "model": "qwen-turbo",
      "config": {
        "maxIterations": 5,
        "inputKey": "content_request",
        "outputKey": "final_content",
        "graphAction": "createGraphAction",
        "reflectionAction": "createReflectionAction"
      },
      "inputMapping": {
        "content_request": "analysis_result"
      },
      "outputMapping": {
        "final_content": "final_result"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "content_generator"
        },
        {
          "name": "translation_service"
        }
      ]
    }
  ],
  "edges": [
    {
      "edgeId": "edge1",
      "fromAgentId": "START",
      "toAgentId": "simple_llm_agent",
      "label": "开始处理",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge2",
      "fromAgentId": "simple_llm_agent",
      "toAgentId": "research_agent",
      "label": "开始研究",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge3",
      "fromAgentId": "research_agent",
      "toAgentId": "analysis_agent",
      "label": "分析数据",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge4",
      "fromAgentId": "analysis_agent",
      "toAgentId": "content_agent",
      "label": "生成内容",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge5",
      "fromAgentId": "content_agent",
      "toAgentId": "END",
      "label": "完成",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    }
  ],
  "globalConfig": {
    "maxRetries": 3,
    "timeout": 30000,
    "enableLogging": true,
    "enableMetrics": true,
    "maxLoopIterations": 3,
    "parallelExecution": false
  },
  "metadata": {
    "createdAt": "2024-01-01T00:00:00Z",
    "lastUpdatedAt": "2024-01-01T00:00:00Z",
    "author": "AI Assistant",
    "tags": ["demo", "tools"],
    "category": "demonstration",
    "customFields": {
      "framework": "spring-ai-alibaba-graph",
      "version": "1.0.0",
      "features": ["Tools", "ToolDefinition"]
    }
  }
} 