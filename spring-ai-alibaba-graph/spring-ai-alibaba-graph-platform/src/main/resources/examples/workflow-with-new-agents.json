{
  "workflowId": "new-agents-workflow-demo",
  "name": "新Agent类型工作流演示",
  "description": "展示如何使用三种新的Agent类型：ReactAgent、ReactAgentWithHuman、ReflectAgent",
  "version": "1.0.0",
  "agents": [
    {
      "agentId": "topic_research",
      "name": "主题研究Agent",
      "type": "react",
      "description": "研究博客主题的热度和可行性",
      "instructions": "你是一个专业的选题专家，负责分析技术博客主题的热度、可行性和受众兴趣。",
      "model": "qwen-turbo",
      "config": {
        "prompt": "请分析以下技术博客主题的热度和可行性：{topic}",
        "maxIterations": 5,
        "inputKey": "topic",
        "outputKey": "research_result"
      },
      "inputMapping": {
        "topic": "user_topic"
      },
      "outputMapping": {
        "research_result": "topic_analysis"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      }
    },
    {
      "agentId": "content_generation",
      "name": "内容生成Agent",
      "type": "react_with_human",
      "description": "生成博客内容",
      "instructions": "你是一个专业的技术博客作者，负责根据研究结果生成高质量的博客内容。",
      "model": "qwen-turbo",
      "config": {
        "prompt": "请根据以下研究结果生成一篇技术博客：{research_result}",
        "maxIterations": 8,
        "inputKey": "research_result",
        "outputKey": "blog_content"
      },
      "inputMapping": {
        "research_result": "topic_analysis"
      },
      "outputMapping": {
        "blog_content": "final_content"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      }
    },
    {
      "agentId": "content_reflection",
      "name": "内容反思Agent",
      "type": "reflect",
      "description": "反思和改进博客内容",
      "instructions": "你是一个内容质量专家，负责反思和改进博客内容的质量。",
      "model": "qwen-turbo",
      "config": {
        "maxIterations": 3,
        "inputKey": "blog_content",
        "outputKey": "improved_content"
      },
      "inputMapping": {
        "blog_content": "final_content"
      },
      "outputMapping": {
        "improved_content": "final_result"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      }
    }
  ],
  "edges": [
    {
      "edgeId": "edge1",
      "fromAgentId": "START",
      "toAgentId": "topic_research",
      "label": "开始研究",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge2",
      "fromAgentId": "topic_research",
      "toAgentId": "content_generation",
      "label": "生成内容",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge3",
      "fromAgentId": "content_generation",
      "toAgentId": "content_reflection",
      "label": "反思改进",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge4",
      "fromAgentId": "content_reflection",
      "toAgentId": "END",
      "label": "完成",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    }
  ],
  "globalConfig": {
    "maxRetries": 3,
    "timeout": 30000,
    "enableLogging": true,
    "enableMetrics": true,
    "maxLoopIterations": 3,
    "parallelExecution": false
  },
  "metadata": {
    "createdAt": "2024-01-01T00:00:00Z",
    "lastUpdatedAt": "2024-01-01T00:00:00Z",
    "author": "AI Assistant",
    "tags": ["demo", "new-agents", "blog-writing"],
    "category": "demonstration",
    "customFields": {
      "framework": "spring-ai-alibaba-graph",
      "version": "1.0.0"
    }
  }
} 