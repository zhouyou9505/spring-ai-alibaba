{
  "workflowId": "conditional-edges-demo",
  "name": "条件边工作流演示",
  "description": "展示如何使用 Map 格式的条件边进行分支控制",
  "version": "1.0.0",
  "agents": [
    {
      "agentId": "reception_agent",
      "name": "接待Agent",
      "type": "llm",
      "description": "接待客户并收集基本信息",
      "instructions": "你是一个客服接待员，请友好地接待客户，了解他们的需求。",
      "model": "qwen-turbo",
      "config": {
        "inputKey": "user_message",
        "outputKey": "reception_result"
      },
      "inputMapping": {
        "user_message": "user_input"
      },
      "outputMapping": {
        "reception_result": "reception_output"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": []
    },
    {
      "agentId": "problem_classification_agent",
      "name": "问题分类Agent",
      "type": "llm",
      "description": "根据客户需求分类问题类型",
      "instructions": "你是一个问题分类专家，请根据客户的需求将问题分类为：technical（技术问题）、satisfaction（满意度调查）、billing（账单问题）或其他类型。",
      "model": "qwen-turbo",
      "config": {
        "inputKey": "reception_output",
        "outputKey": "problem_type"
      },
      "inputMapping": {
        "reception_output": "reception_result"
      },
      "outputMapping": {
        "problem_type": "problem_type"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": []
    },
    {
      "agentId": "technical_support_agent",
      "name": "技术支持Agent",
      "type": "react",
      "description": "处理技术问题",
      "instructions": "你是一个技术支持专家，请帮助客户解决技术问题。",
      "model": "qwen-turbo",
      "config": {
        "inputKey": "reception_output",
        "outputKey": "technical_solution"
      },
      "inputMapping": {
        "reception_output": "reception_result"
      },
      "outputMapping": {
        "technical_solution": "technical_result"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "system_diagnostic",
          "autoMock": true
        },
        {
          "name": "troubleshooting_guide",
          "autoMock": true
        }
      ]
    },
    {
      "agentId": "satisfaction_survey_agent",
      "name": "满意度调查Agent",
      "type": "llm",
      "description": "进行客户满意度调查",
      "instructions": "你是一个客户满意度调查员，请进行客户满意度调查。",
      "model": "qwen-turbo",
      "config": {
        "inputKey": "reception_output",
        "outputKey": "satisfaction_result"
      },
      "inputMapping": {
        "reception_output": "reception_result"
      },
      "outputMapping": {
        "satisfaction_result": "survey_result"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": []
    },
    {
      "agentId": "billing_support_agent",
      "name": "账单支持Agent",
      "type": "react",
      "description": "处理账单相关问题",
      "instructions": "你是一个账单支持专家，请帮助客户处理账单相关问题。",
      "model": "qwen-turbo",
      "config": {
        "inputKey": "reception_output",
        "outputKey": "billing_solution"
      },
      "inputMapping": {
        "reception_output": "reception_result"
      },
      "outputMapping": {
        "billing_solution": "billing_result"
      },
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "payment_processor",
          "autoMock": true
        },
        {
          "name": "invoice_generator",
          "autoMock": true
        }
      ]
    }
  ],
  "edges": [
    {
      "edgeId": "edge1",
      "fromAgentId": "START",
      "toAgentId": "reception_agent",
      "label": "开始",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge2",
      "fromAgentId": "reception_agent",
      "toAgentId": "problem_classification_agent",
      "label": "转接到问题分类Agent",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge3",
      "fromAgentId": "problem_classification_agent",
      "toAgentId": "technical_support_agent",
      "label": "技术问题",
      "condition": "{\"problem_type\": \"technical\"}",
      "edgeType": "CONDITIONAL",
      "config": {}
    },
    {
      "edgeId": "edge4",
      "fromAgentId": "problem_classification_agent",
      "toAgentId": "satisfaction_survey_agent",
      "label": "满意度调查",
      "condition": "{\"problem_type\": \"satisfaction\"}",
      "edgeType": "CONDITIONAL",
      "config": {}
    },
    {
      "edgeId": "edge5",
      "fromAgentId": "problem_classification_agent",
      "toAgentId": "billing_support_agent",
      "label": "账单问题",
      "condition": "{\"problem_type\": \"billing\"}",
      "edgeType": "CONDITIONAL",
      "config": {}
    },
    {
      "edgeId": "edge6",
      "fromAgentId": "technical_support_agent",
      "toAgentId": "satisfaction_survey_agent",
      "label": "技术支持完成",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge7",
      "fromAgentId": "billing_support_agent",
      "toAgentId": "satisfaction_survey_agent",
      "label": "账单支持完成",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    },
    {
      "edgeId": "edge8",
      "fromAgentId": "satisfaction_survey_agent",
      "toAgentId": "END",
      "label": "结束",
      "condition": null,
      "edgeType": "SEQUENTIAL",
      "config": {}
    }
  ],
  "globalConfig": {
    "maxRetries": 3,
    "timeout": 60000,
    "enableLogging": true,
    "enableMetrics": true,
    "maxLoopIterations": 5,
    "parallelExecution": false
  },
  "metadata": {
    "createdAt": "2024-01-01T00:00:00Z",
    "lastUpdatedAt": "2024-01-01T00:00:00Z",
    "author": "AI Assistant",
    "tags": ["conditional-edges", "multi-agent", "workflow", "customer-service"],
    "category": "customer-support",
    "customFields": {
      "estimatedDuration": "10-20 minutes",
      "complexity": "medium",
      "requiredAgents": 5,
      "conditionalLogic": "Map-based conditions"
    }
  }
} 