      "model": "qwen-turbo",
      "config": {
        "maxIterations": 8
      },
      "inputKey": "reception_output",
      "outputKey": "data_analysis_output",
      "options": {
        "toggleAble": true,
        "controlType": "auto",
        "outputVisibility": "public",
        "maxRetries": 3,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "data_processor",
          "autoMock": true
        },
        {
          "name": "chart_generator",
          "autoMock": true
        },
        {
          "name": "statistical_analyzer",
          "autoMock": true
        }
      ]
    },
